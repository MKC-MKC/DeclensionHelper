{
    "name": "haikiri/declension-helper",
    "description": "This package is made for work with the declensions of pronouns in languages such as Russian and Ukrainian.",
    "keywords": [
        "php",
        "pronouns",
        "language",
        "declension"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Haikiri\\DeclensionHelper\\": "src/"
        }
    },
    "autoload-dev": {},
    "authors": [
        {
            "name": "Haikiri",
            "email": "haikiri@ya.ru",
            "homepage": "https://haikiri.t.me"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "conflict": {
        "doctrine/instantiator": ">=2.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always src/DeclensionTest.php",
        "test:debug": "vendor/bin/phpunit --colors=always --debug src/DeclensionTest.php",
        "test:dox": "vendor/bin/phpunit --colors=always --testdox src/DeclensionTest.php"
    }
}
